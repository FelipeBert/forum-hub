# AWS region where resources will be deployed
region = "sa-east-1"

# Administrator IP for SSH access (Master) and the UI (SonarQube)
# Use the format "X.X.X.X" (the /32 mask is applied automatically by the module)
ip_admin = "YOUR_PERSONAL_IPV4"

# Main VPC CIDR block
vpc_cidr = "10.0.0.0/16"

# List of CIDR blocks for the public subnets
# The NAT Gateway will be provisioned in the first subnet in this list
public_subnets_cidr = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

# List of CIDR blocks for the private subnets
# Note: The RDS Subnet Group requires subnets in different AZs
private_subnets_cidr = [
  "10.0.3.0/24",
  "10.0.4.0/24"
]